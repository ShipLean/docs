---
import type { ImageMetadata } from 'astro';

interface Props { name: string; alt: string }
const { name, alt } = Astro.props;
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/product-shots/*.webp', { eager: true });
const light = shots[`../assets/product-shots/${name}-light.webp`]?.default;
const dark = shots[`../assets/product-shots/${name}-dark.webp`]?.default;
if (!light || !dark) throw new Error(`Missing product screenshot pair: ${name}`);
---

<figure class="product-shot">
  <img class="light" src={light.src} width={light.width} height={light.height} alt={alt} loading="lazy" decoding="async" />
  <img class="dark" src={dark.src} width={dark.width} height={dark.height} alt={alt} loading="lazy" decoding="async" />
</figure>

<style>
  .product-shot { margin: 1.5rem 0; overflow: hidden; border: 1px solid var(--sl-color-hairline); border-radius: 0.5rem; }
  .product-shot img { width: 100%; height: auto; margin: 0; }
  .light { display: block; }
  .dark { display: none; }
  :global([data-theme='dark']) .light { display: none; }
  :global([data-theme='dark']) .dark { display: block; }
</style>
