# ShipLean environment for the matching pomerium.yaml.
SHIPLEAN_AUTH_PROXY_TOKEN_HEADER=X-Pomerium-Jwt-Assertion
SHIPLEAN_AUTH_PROXY_TOKEN_ISSUER=https://shiplean.example.com/
SHIPLEAN_AUTH_PROXY_TOKEN_AUDIENCE=shiplean.example.com
SHIPLEAN_AUTH_PROXY_SIGN_OUT_URL=https://shiplean.example.com/.pomerium/sign_out
SHIPLEAN_TRUSTED_PROXIES=10.20.0.0/24
SHIPLEAN_ADMIN_EMAIL=admin@example.com
