# ShipLean environment for plain-header mode behind Authelia.
# Trusted headers: https://www.authelia.com/integration/trusted-header-sso/introduction/
SHIPLEAN_AUTH_PROXY_EMAIL_HEADER=Remote-Email
SHIPLEAN_AUTH_PROXY_NAME_HEADER=Remote-Name
SHIPLEAN_AUTH_PROXY_SIGN_OUT_URL=https://auth.example.com/logout
SHIPLEAN_TRUSTED_PROXIES=10.20.0.10
SHIPLEAN_ADMIN_EMAIL=admin@example.com
