# ShipLean environment for the matching oauth2-proxy.cfg.
# oauth2-proxy option reference: https://oauth2-proxy.github.io/oauth2-proxy/configuration/overview/
SHIPLEAN_AUTH_PROXY_TOKEN_HEADER=X-Forwarded-Access-Token
SHIPLEAN_AUTH_PROXY_TOKEN_ISSUER=https://idp.example.com/realms/main
SHIPLEAN_AUTH_PROXY_TOKEN_AUDIENCE=shiplean
SHIPLEAN_AUTH_PROXY_SIGN_OUT_URL=/oauth2/sign_out
SHIPLEAN_TRUSTED_PROXIES=10.20.0.0/24
SHIPLEAN_ADMIN_EMAIL=admin@example.com
